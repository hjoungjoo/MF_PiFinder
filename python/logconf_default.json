{
    // Note that the JSON5 library that we use for configuration supports comments in JSON files.
    "version": 1,
    "disable_existing_loggers": false, // THIS MUST BE FALSE for logging to work
    "formatters": {
        "default": {
            "format": "%(asctime)s %(processName)s-%(name)s:%(levelname)s:%(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "ERROR",
            "formatter": "default",
            "stream": "ext://sys.stdout"
        },
        "null": {
            "class": "logging.NullHandler",
            "level": "ERROR"
        }
    },
    "loggers": {

        //
        /////////////////////////////////////////////////////////////////
        ////// root logger
        //
        // This is the main logging configuration
        //
        "": {
            "level": "ERROR",
            "handlers": ["console"]
            // The file handler is added automatically by code
        },

        /////////////////////////////////////////////////////////////////
        ////// Web Server Subsystem (Flask with Jinja2 i18n)
        //
        // Supported logger hierarchy:
        //   Server
        "Server": {
            "level": "INFO"
        },
        "Server.Logs": {
            "level": "ERROR"
        },

        /////////////////////////////////////////////////////////////////
        ////// INDI mount control / GoTo-Guide / pointing coordinate
        //
        // INFO by default since 2026-07-25 (field-test item D12): the log
        // file now rotates on tmpfs (utils.log_dir), so the continuous
        // INFO stream (GoTo/sync commands, recovery slews, guide pulses,
        // tracking-guide state transitions) no longer wears the SD card,
        // and a field incident can be reconstructed afterwards.  Persist a
        // session worth keeping with "Save to SD" on the web Logs page
        // BEFORE powering off -- tmpfs logs vanish on reboot.
        "MountControl": {
            "level": "INFO"
        },
        "IndiGotoGuideService": {
            "level": "INFO"
        },
        "PointingCoordinateService": {
            "level": "INFO"
        },
        // SkySafari LX200 server: GoTo/sync routing decisions, guide bridge,
        // clock-jump re-syncs. Same D12 rationale as above.
        "PosServer": {
            "level": "INFO"
        },
        // Clock-trust marker writes and time-source selection (A4/A5).
        // Parent "GPS" stays WARNING so parser chatter is not logged.
        "GPS.TimeSync": {
            "level": "INFO"
        },
        // Main loop: manual time set, GPS time adoption, UI commands.
        "main": {
            "level": "INFO"
        },

        /////////////////////////////////////////////////////////////////
        ////// Flask Framework (used for webserver)
        //
        // Flask and related component logging
        //
        "waitress": {
            "level": "ERROR"
        },
        "flask": {
            "level": "ERROR"
        },
        "flask.app": {
            "level": "ERROR"
        },

        /////////////////////////////////////////////////////////////////
        ////// Solver
        "Solver": {
            "level": "ERROR"
        },

        /////////////////////////////////////////////////////////////////
        ////// On-disk caches (Hipparcos pickle, catalog composite pickle)
        "Plot": {
            "level": "INFO"
        },
        "Catalog.Cache": {
            "level": "INFO"
        },

        /////////////////////////////////////////////////////////////////
        ////// GPS Subsystem
        "GPS": {
            "level": "WARNING" // Set this to DEBUG, to see results parsed from the GPS
        },
        "GPS.parser": {
            "level": "WARNING" // Set this to DEBUG, to see results parsed from the GPS
        },
        "GPS.fake": {
            "level": "WARNING"
        },

        /////////////////////////////////////////////////////////////////
        ////// Third party Libraries
        //
        // Silence logging of libraries that we use.
        //
        "PIL.PngImagePlugin": {
            "level": "WARNING"
        },
        "tetra3.Tetra3": {
            "level": "WARNING"
        },
        "picamera2.picamera2": {
            "level": "WARNING"
        },
        "grpc": {
            "level": "ERROR",
            "propagate": false,
            "handlers": ["null"]
        },
   }
}